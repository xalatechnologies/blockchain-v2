# Noor Chain Oracle Node Configuration

# Blockchain Connection
ORACLE_RPC_URL=https://rpc.noorchain.org
ORACLE_PRIVATE_KEY=your_oracle_wallet_private_key_here

# Oracle Contract Addresses (will be set after deployment)
GOLD_ORACLE_ADDRESS=
AED_ORACLE_ADDRESS=
KES_ORACLE_ADDRESS=
NOK_ORACLE_ADDRESS=
SEK_ORACLE_ADDRESS=
DKK_ORACLE_ADDRESS=

# API Keys (optional but recommended for higher rate limits)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Update Configuration
UPDATE_INTERVAL_SECONDS=300  # 5 minutes

# Gas Configuration
GAS_PRICE_GWEI=1
