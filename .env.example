# ==============================================================================
# Xaheen Chain Environment Configuration Template
# ==============================================================================
#
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
#
# cp .env.example .env
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Xaheen Chain Network Configuration
# ------------------------------------------------------------------------------

# Chain identity
CHAIN_ID=65001
NETWORK_ID=65001
CHAIN_NAME=Xaheen Chain
CHAIN_DOMAIN=xaheen.org

# RPC Configuration
RPC_ADDR=0.0.0.0
RPC_PORT=8545
WS_PORT=8546
P2P_PORT=30303

# ------------------------------------------------------------------------------
# Validator Configuration
# ------------------------------------------------------------------------------

# Primary validator address (replace with your validator address)
VALIDATOR_ADDRESS=0x81bDAf1ac2094D5133937B3361A38a4976E55acc

# Pre-fund EOA for gas (optional - for testing/development)
FUND_EOA=0x81bDAf1ac2094D5133937B3361A38a4976E55acc
FUND_BAL_HEX=0x3635c9adc5dea00000  # 1000 XHT in wei

# ------------------------------------------------------------------------------
# Wallet Configuration
# ------------------------------------------------------------------------------

# Main wallet for deployments and operations
# WARNING: Keep this secret! Never commit to git!
MAIN_WALLET_PRIVATE_KEY=your_private_key_here_without_0x_prefix
MAIN_WALLET=0xYourMainWalletAddress

# ------------------------------------------------------------------------------
# Bridge Deployment Keys (Day 2)
# ------------------------------------------------------------------------------

# BSC Mainnet deployer key (for mainnet bridge deployment)
# Get testnet BNB from: https://testnet.binance.org/faucet-smart
MAINNET_PRIVATE_KEY=your_bsc_mainnet_private_key_here

# Xaheen Chain deployer key (can be same as MAIN_WALLET_PRIVATE_KEY)
PRIVATE_CHAIN_KEY=your_xaheen_chain_private_key_here

# BSC Testnet deployer key (for testing before mainnet)
TESTNET_PRIVATE_KEY=your_bsc_testnet_private_key_here

# ------------------------------------------------------------------------------
# RPC Endpoints
# ------------------------------------------------------------------------------

# BSC Mainnet RPC
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/

# Xaheen Chain RPC
PRIVATE_CHAIN_RPC=https://rpc.xaheen.org
# For local development: http://localhost:8545
# Legacy RPC (during migration): https://rpc.bitcoinbr.tech

# ------------------------------------------------------------------------------
# Contract Addresses
# ------------------------------------------------------------------------------

# BTCBR token contract address (bridged from BSC mainnet)
BTCBR_ADDR=0x0cF8e180350253271f4b917CcFb0aCCc4862F262

# ------------------------------------------------------------------------------
# API Keys and External Services
# ------------------------------------------------------------------------------

# BSCScan API key (for contract verification)
# Get your API key at: https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ------------------------------------------------------------------------------
# AWS Configuration (for cloud deployment)
# ------------------------------------------------------------------------------

# AWS region for deployment
AWS_REGION=us-east-1

# EC2 instance type (t3.large recommended for production)
AWS_INSTANCE_TYPE=t3.large

# EBS volume size in GB
AWS_VOLUME_SIZE=100

# AWS credentials (if not using AWS CLI profile)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ------------------------------------------------------------------------------
# Validator Addresses (Multi-sig 2-of-3)
# ------------------------------------------------------------------------------

# These are the three validator addresses for multi-signature validation
# Do NOT change these unless you're setting up a new network
VALIDATOR_1=0xFAA5AA97651c2e2b6860219bb8f9902d416dB5DD
VALIDATOR_2=0xfd634d55ce9b99058dc06cdda1f866b39579a9f3
VALIDATOR_3=0xb753b892551d1c374fda6fd7f6e9b787688c4ea5

# ------------------------------------------------------------------------------
# Development/Testing Settings
# ------------------------------------------------------------------------------

# Enable debug mode (set to "true" for verbose logging)
DEBUG=false

# Gas price multiplier (1.0 = normal, 1.5 = 50% higher)
GAS_PRICE_MULTIPLIER=1.0

# Transaction timeout in seconds
TX_TIMEOUT=120

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
#
# Security Best Practices:
# 1. Never commit .env files to git (.gitignore already configured)
# 2. Use strong, unique private keys
# 3. Rotate keys regularly
# 4. Keep backup of keys in secure location (hardware wallet, password manager)
# 5. Use different keys for testnet and mainnet
# 6. Consider using AWS Secrets Manager or HashiCorp Vault for production
#
# Network Information:
# - Chain ID: 65001 (Xaheen Chain)
# - Native Token: XHT (Xaheen Token, 18 decimals)
# - Block Time: 3 seconds
# - Consensus: Parlia PoSA
# - Domain: xaheen.org
#
# Quick Commands:
# - Compile contracts:  npm run compile
# - Deploy to mainnet:  npm run deploy:mainnet
# - Deploy to Xaheen:   npm run deploy:xaheen
# - Deploy bridges:     npm run deploy:bridges
#
# Documentation:
# - Full docs: docs/README.md
# - Brand guide: docs/branding/XAHEEN_BRAND_GUIDE.md
# - Migration: docs/migration/CHAIN_ID_MIGRATION.md
#
# ==============================================================================
