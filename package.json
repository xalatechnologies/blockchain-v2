{
  "name": "xaheen-chain",
  "version": "1.0.0",
  "description": "Xaheen Chain - An intelligent, high-performance private blockchain network based on BNB Smart Chain (BSC/Parlia-PoSA) technology with comprehensive bridge infrastructure. Chain ID: 65001, Native Token: XHT",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npx hardhat test",
    "compile": "npx hardhat compile",
    "deploy:mainnet": "npx hardhat run scripts/hardhat-deploy-mainnet.js --network bsc",
    "deploy:xaheen": "npx hardhat run scripts/hardhat-deploy-private.js --network btcbr",
    "deploy:testnet": "npx hardhat run scripts/hardhat-deploy-mainnet.js --network bscTestnet",
    "deploy:bridges": "./scripts/deploy-bridge-complete.sh"
  },
  "keywords": [
    "xaheen",
    "xaheen-chain",
    "blockchain",
    "bsc",
    "parlia",
    "bridge",
    "xht",
    "xaheen-token",
    "smart-contracts",
    "ethereum",
    "evm",
    "defi",
    "web3"
  ],
  "author": "Xaheen Chain Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xaheen-chain/blockchain-v2"
  },
  "homepage": "https://xaheen.org",
  "bugs": {
    "url": "https://github.com/xaheen-chain/blockchain-v2/issues"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "dotenv": "^17.2.3",
    "solc": "^0.8.20",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.1",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.4",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "type": "module"
